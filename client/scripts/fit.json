      "height": 390
    },
    {
      "name": "tablet-portrait",
      "width": 768,
      "height": 1024
    },
    {
      "name": "tablet-landscape",
      "width": 1024,
      "height": 768
    },
    {
      "name": "laptop",
      "width": 1366,
      "height": 768
    },
    {
      "name": "desktop",
      "width": 1600,
      "height": 960
    },
    {
      "name": "desktop-short",
      "width": 1280,
      "height": 600
