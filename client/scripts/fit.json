{
  "siteConfig": "site/vite.config.ts",
  "outDir": "proof/fit",
  "regions": [
    ".topbar",
    ".stage",
    ".devices",
    ".inspector",
    ".pane-nav",
    ".run",
    ".stage-card",
    ".stage-controls"
  ],
  "sheetSelector": ".sheet",
  "contained": [
    [
      ".stage-controls",
      ".stage"
    ],
    [
      ".title-block",
      ".stage"
    ],
    [
      ".run",
      ".app"
    ],
    [
      ".stage-label",
      ".stage-card"
    ],
    [
      ".stage-detail",
      ".stage-card"
    ],
    [
      ".device-name",
      ".device"
    ],
    [
      ".brand",
      ".topbar"
    ],
    [
      ".hub-link",
      ".topbar"
    ],
    [
      ".fleet",
      ".topbar"
    ],
    [
      ".theme-toggle",
      ".topbar"
    ]
  ],
  "truncated": [
    ".brand-name",
    ".run",
    ".pane-nav button",
    ".tabs button",
    ".code ol"
  ],
  "tabs": [
    "overview",
    "port",
    "kit",
    "data",
    "deliver"
  ],
  "readySelector": ".drawing [data-item=\"bridge\"]",
  "runSelector": "button.run",
  "navSelector": ".pane-nav button",
  "devicesPane": "devices",
  "stagePane": "stage",
  "inspectorPane": "inspector",
  "kitSwitch": ".stage-switch",
  "kitReadySelector": ".sheet.is-kit .drawing [data-item=\"case\"]",
  "partSelector": ".part-row",
  "deviceAttribute": "data-device",
  "runMs": 5200,
  "minSheetHeight": 120,
  "tappable": [
    ".segmented button",
    ".slider input",
    ".stage-controls .chip",
    ".zoom button",
    ".pane-nav button",
    ".tabs button",
    ".run",
    ".stage-switch",
    ".part-row",
    ".kit-open",
    ".filter",
    ".hub-link",
    ".theme-toggle",
    ".device:not(.is-planned)",
    ".code-copy"
  ],
  "sliderSelector": ".slider input",
  "motionMs": 3000,
  "spacing": [
    {
      "button": ".segmented button:nth-child(1)",
      "value": "0"
    },
    {
      "button": ".segmented button:nth-child(2)",
      "value": "1"
    }
  ],
  "layout": {
    "rows": [
      ".pane-nav button",
      ".stage-card"
    ],
    "frames": [
      ".topbar",
      ".pipeline",
      ".dock"
    ],
    "compactFrames": [
      ".devices",
      ".stage",
      ".inspector"
    ],
    "headings": [
      ".brand-name",
      ".inspector-title",
      ".device-name",
      ".ledger-substance"
    ],
    "headingLines": 2,
    "tolerance": 1
  },
  "lightSelector": ".stage"
}
