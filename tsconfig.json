{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@shared/*": ["./shared/*"], "@client/*": ["./client/*"], "@server/*": ["./server/*"], "@design/*": ["./design/*"] }
  },
  "include": ["shared", "client", "server", "tests", "tools", "design", "*.ts"]
}
