{
  "name": "bench-bridge",
  "private": true,
  "type": "module",
  "homepage": "https://bench-bridge.juntotechnologies.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juntotechnologies/bench-bridge.git"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "build:pages": "tsc --noEmit && vite build --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsx tools/check-agents-md.ts && tsx tools/docs/sync.ts && tsx design/build.ts --check && tsx tools/seo/build.ts --check",
    "test": "vitest run",
    "proof": "tsx client/scripts/proof-drawings.ts",
    "drawings": "tsx client/scripts/check-drawings.ts",
    "health": "tsx server/health.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run drawings && npm run build && npm run build:pages",
    "docs": "tsx tools/docs/sync.ts --write",
    "media": "npm run build:pages && tsx client/scripts/capture-media.ts",
    "fit": "npm run build:pages && tsx client/scripts/check-fit.ts",
    "design": "tsx design/build.ts",
    "seo": "tsx tools/seo/build.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
